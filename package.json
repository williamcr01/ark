{
  "name": "ark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,sandbox,web -c magenta,yellow,cyan \"pnpm --filter @ark/api dev\" \"pnpm --filter @ark/sandbox dev\" \"pnpm --filter @ark/web dev\"",
    "dev:client": "pnpm --filter @ark/web dev",
    "dev:server": "pnpm --filter @ark/api dev",
    "dev:sandbox": "pnpm --filter @ark/sandbox dev",
    "server": "pnpm --filter @ark/api start",
    "sandbox": "pnpm --filter @ark/sandbox start",
    "start": "concurrently -n api,sandbox -c magenta,yellow \"pnpm server\" \"pnpm sandbox\"",
    "db:migrate": "pnpm --filter @ark/api db:migrate",
    "build": "tsc -b && pnpm --filter @ark/web exec vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "preview": "pnpm --filter @ark/web preview",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:live-chromium": "pnpm --filter @ark/api test:live-chromium",
    "lockfile:check": "pnpm install --frozen-lockfile",
    "smoke:plain-css": "tsx scripts/smoke-plain-css.ts",
    "smoke:reveal-runtime": "tsx scripts/smoke-reveal-runtime.ts",
    "smoke:full-js-bridge": "tsx scripts/smoke-full-js-bridge.ts",
    "smoke:manual-edit": "tsx scripts/smoke-manual-edit.ts",
    "smoke:thumbnails": "tsx scripts/smoke-thumbnails.ts",
    "smoke:browser": "pnpm smoke:plain-css && pnpm smoke:reveal-runtime && pnpm smoke:full-js-bridge && pnpm smoke:manual-edit",
    "smoke:browser:extended": "pnpm smoke:reveal-runtime && pnpm smoke:full-js-bridge && pnpm smoke:manual-edit && pnpm smoke:thumbnails",
    "benchmark:renderer": "tsx scripts/benchmark-renderer.ts",
    "benchmark:settle-delta": "tsx scripts/benchmark-settle-delta.ts",
    "test:benchmark-renderer": "tsx --test scripts/lib/renderer-benchmark.test.ts",
    "sync-runtimes": "tsx scripts/sync-runtime-manifest.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@ark/contracts": "workspace:*",
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "chart.js": "4.5.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.9.3",
    "reveal.js": "5.1.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
