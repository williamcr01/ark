{
  "name": "ark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "pnpm --filter @ark/desktop run start",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "pnpm --filter @ark/desktop run build",
    "package": "pnpm --filter @ark/desktop run pack",
    "package:installers": "pnpm --filter @ark/desktop run dist",
    "lint": "oxlint . && eslint . --cache --cache-location .eslintcache",
    "lint:eslint": "eslint . --cache --cache-location .eslintcache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/ark-test-compile vitest run --config vitest.config.ts",
    "test:affected": "node scripts/ci-run-affected-tests.mjs",
    "test:ci-scope": "node --test scripts/ci-test-scope.test.mjs scripts/typecheck.test.mjs",
    "lockfile:check": "pnpm install --frozen-lockfile",
    "smoke:desktop": "pnpm build && node scripts/smoke-desktop.mjs",
    "sync-runtimes": "tsx scripts/sync-runtime-manifest.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@ark/contracts": "workspace:*",
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "chart.js": "4.5.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.3",
    "reveal.js": "5.1.0",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
