# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Optional legacy default for OpenAI only. Prefer ARK_DEFAULT_MODEL for multi-provider defaults.
# OPENAI_MODEL=gpt-4o-mini

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (Google)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Optional: default model as provider:model-id (e.g. anthropic:claude-sonnet-4-20250514)
# ARK_DEFAULT_MODEL=openai:gpt-4o-mini

# Optional: API server port (default 8787). Vite reads the same PORT and proxies /api here.
PORT=8787
