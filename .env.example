# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Optional legacy default for OpenAI only. Prefer ARK_DEFAULT_MODEL for multi-provider defaults.
# OPENAI_MODEL=gpt-5.6-luna

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (Google)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Optional: default model as provider:model-id (must be a curated catalog entry)
# ARK_DEFAULT_MODEL=openai:gpt-5.6-luna

# Optional: API server port (default 8787). Vite reads the same PORT and proxies /api here.
PORT=8787

# Optional: separate sandbox origin for deck preview iframes (default http://localhost:5174).
# ARK_SANDBOX_ORIGIN=http://localhost:5174
# SANDBOX_PORT=5174

# Optional: app shell origin used for sandbox parent/deck postMessage scoping (default http://localhost:5173).
# ARK_APP_ORIGIN=http://localhost:5173

# Optional: force legacy srcDoc preview instead of the sandbox host (default: sandbox host).
# VITE_ARK_PREVIEW_SRCDOC=true

# Optional: disable the sandbox-backed thumbnail renderer (falls back to client srcDoc thumbnails).
# ARK_THUMBNAIL_RENDERER=off
# Optional: Chromium binary for thumbnail rendering (also used by browser smoke tests).
# ARK_CHROMIUM_PATH=/usr/bin/google-chrome
# Optional: always launch thumbnail Chromium with --no-sandbox (skip sandboxed probe).
# Useful in containers/CI without user namespaces. Accepts true/1/yes/on.
# When unset, Ark tries a sandboxed launch first and falls back to --no-sandbox on failure.
# ARK_CHROMIUM_NO_SANDBOX=true
# Optional: thumbnail PNG cache directory (default data/thumbnails).
# ARK_THUMBNAIL_CACHE_DIR=
# Optional: thumbnail render queue concurrency (positive integer, default 1).
# ARK_THUMBNAIL_QUEUE_CONCURRENCY=1
# Optional: per-slide thumbnail settle delay in milliseconds (non-negative integer, default 80).
# ARK_THUMBNAIL_SETTLE_MS=80

# Optional: Postgres persistence. When unset, Ark uses local JSON files in data/decks.
# DATABASE_URL=postgres://ark:ark@localhost:5432/ark
# PGSSLMODE=disable
# DATABASE_POOL_SIZE=10

# Optional: directory of always-on agent markdown guides (default: <repo>/agent-guides).
# ARK_AGENT_GUIDES_DIR=
# Optional: max UTF-8 bytes for concatenated guides (default: 131072).
# ARK_AGENT_GUIDES_MAX_BYTES=
