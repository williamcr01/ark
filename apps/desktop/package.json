{
  "name": "@ark/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first AI presentation builder for the desktop",
  "author": {
    "name": "williamcr01",
    "email": "williamcrona@gmail.com"
  },
  "homepage": "https://github.com/williamcr01/ark",
  "desktopName": "ark.desktop",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "node ../../scripts/typecheck.mjs apps/desktop/tsconfig.app.json apps/desktop/tsconfig.node.json",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:main && pnpm build:preload",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.electron.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "start": "electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/ark-test-compile pnpm --dir ../.. exec vitest run --config vitest.config.ts --project '@ark/desktop-*'"
  },
  "dependencies": {
    "@ark/ai": "workspace:*",
    "@ark/api": "workspace:*",
    "@ark/chat": "workspace:*",
    "@ark/contracts": "workspace:*",
    "@ark/deck": "workspace:*",
    "@ark/deck-export": "workspace:*",
    "@ark/deck-preview": "workspace:*",
    "@ark/editor-runtime": "workspace:*",
    "@ark/mcp": "workspace:*",
    "@ark/mcp-server": "workspace:*",
    "@ark/runtime-registry": "workspace:*",
    "@ark/sandbox": "workspace:*",
    "@ark/storage": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^6.0.199",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "express": "5.2.1",
    "jsonc-parser": "^3.3.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "4.0.1",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.2",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.arkpresentations.desktop",
    "productName": "Ark",
    "artifactName": "Ark-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../../release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../runtimes",
        "to": "runtimes"
      },
      {
        "from": "../../agent-guides",
        "to": "agent-guides"
      },
      {
        "from": "../../mcp-guides",
        "to": "mcp-guides"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "williamcr01",
      "repo": "ark"
    },
    "linux": {
      "category": "Graphics",
      "executableName": "ark",
      "icon": "build/icon.png",
      "maintainer": "williamcr01 <williamcrona@gmail.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "icon": "build/icon.png",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
