{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@fixtures/*": ["../../test/fixtures/*"],
      "@ark/ai": ["../../packages/ai/index.ts"],
      "@ark/ai/*": ["../../packages/ai/*"],
      "@ark/chat": ["../../packages/chat"],
      "@ark/chat/*": ["../../packages/chat/*"],
      "@ark/contracts": ["../../packages/contracts/index.ts"],
      "@ark/contracts/*": ["../../packages/contracts/*"],
      "@ark/deck": ["../../packages/deck"],
      "@ark/deck/*": ["../../packages/deck/*"],
      "@ark/deck-preview": ["../../packages/deck-preview"],
      "@ark/deck-preview/*": ["../../packages/deck-preview/*"],
      "@ark/editor-runtime": ["../../packages/editor-runtime/index.ts"],
      "@ark/editor-runtime/*": ["../../packages/editor-runtime/*"],
      "@ark/mcp": ["../../packages/mcp"],
      "@ark/mcp/*": ["../../packages/mcp/*"],
      "@ark/runtime-registry": ["../../packages/runtime-registry"],
      "@ark/runtime-registry/*": ["../../packages/runtime-registry/*"],
      "@ark/telemetry": ["../../packages/telemetry/index.ts"],
      "@ark/telemetry/*": ["../../packages/telemetry/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
