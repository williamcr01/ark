{
  "name": "@ark/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "db:migrate": "tsx db/migrate.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:live-chromium": "ARK_LIVE_CHROMIUM_TESTS=1 vitest run --config vitest.config.ts thumbnails/renderer.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.99",
    "@ai-sdk/google": "^3.0.98",
    "@ai-sdk/openai": "^3.0.86",
    "@ark/contracts": "workspace:*",
    "@ark/deck-core": "workspace:*",
    "@ark/runtime-registry": "workspace:*",
    "ai": "^6.0.233",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "nanoid": "^5.1.11",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  }
}
